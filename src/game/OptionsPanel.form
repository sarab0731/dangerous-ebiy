              </component>
              <component id="2eb1b" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font name="Avenir Next" size="14" style="0"/>
                  <text value="FX Volume"/>
                </properties>
              </component>
              <component id="80f1c" class="javax.swing.JLabel" binding="musicVolDisplay">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="75"/>
                </properties>
              </component>
              <component id="c5951" class="javax.swing.JLabel" binding="fxVolDisplay">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="75"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <hspacer id="cc46">
        <constraints border-constraint="East"/>
      </hspacer>
      <hspacer id="8b813">
        <constraints border-constraint="West"/>
      </hspacer>
      <vspacer id="c37bd">
